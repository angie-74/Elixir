1 ICON "@ELIXIR_RC_ICON@"
101 RCDATA "@ELIXIR_RC_LOGO@"
102 RCDATA "@ELIXIR_RC_ICON_PNG@"
103 RCDATA "@ELIXIR_RC_DOWNLOAD_PACKAGE@"
110 RCDATA "@ELIXIR_RC_NOTICES@"
111 RCDATA "@ELIXIR_RC_LICENSE@"
@ELIXIR_RC_BUNDLE@
1 VERSIONINFO
 FILEVERSION @ELIXIR_RC_VERSION_MAJOR@,@ELIXIR_RC_VERSION_MINOR@,@ELIXIR_RC_VERSION_PATCH@,0
 PRODUCTVERSION @ELIXIR_RC_VERSION_MAJOR@,@ELIXIR_RC_VERSION_MINOR@,@ELIXIR_RC_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Elixir Project Authors"
            VALUE "FileDescription", "Elixir"
            VALUE "FileVersion", "@ELIXIR_VERSION@"
            VALUE "InternalName", "Elixir"
            VALUE "LegalCopyright", "Copyright 2026 Elixir Project Authors. Apache License 2.0."
            VALUE "OriginalFilename", "Elixir.exe"
            VALUE "ProductName", "Elixir"
            VALUE "ProductVersion", "@ELIXIR_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
